# 复制为 .env 后按需修改；全部留空也能直接运行。
# 注意：本文件不放任何密钥。模型凭据在网页弹窗里填写。

# 弹窗里的预填默认值（不含密钥，可留空）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# MySQL 持久化（可选）
# 默认关闭：连不上会自动降级为内存 + JSONL，功能不受影响。
# 想把会话持久化到 MySQL，就改成 1 并填好下面几项。
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nante

# 服务监听
HOST=127.0.0.1
PORT=8000
RELOAD=0
